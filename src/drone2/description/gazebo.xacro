<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo reference="body_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="front_marker">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="arm_0">
    <material>Gazebo/Red</material>
  </gazebo>
  <gazebo reference="arm_1">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="arm_2">
    <material>Gazebo/Red</material>
  </gazebo>
  <gazebo reference="arm_3">
    <material>Gazebo/Black</material>
  </gazebo>

  <xacro:macro name="rotor_lift_drag" params="id forward">
    <gazebo>
      <plugin name="rotor_${id}_lift_drag" filename="libLiftDragPlugin.so">
        <a0>0.3</a0>
        <alpha_stall>1.4</alpha_stall>
        <cla>4.25</cla>
        <cda>0.10</cda>
        <cma>0.0</cma>
        <cla_stall>-0.025</cla_stall>
        <cda_stall>0.0</cda_stall>
        <cma_stall>0.0</cma_stall>
        <area>0.002</area>
        <air_density>1.2041</air_density>
        <cp>0 0 0</cp>
        <forward>${forward} 0 0</forward>
        <upward>0 0 1</upward>
        <link_name>drone2::prop_${id}</link_name>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:rotor_lift_drag id="0" forward="1"/>
  <xacro:rotor_lift_drag id="1" forward="-1"/>
  <xacro:rotor_lift_drag id="2" forward="-1"/>
  <xacro:rotor_lift_drag id="3" forward="1"/>

  <gazebo reference="base_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>1000</update_rate>
      <visualize>false</visualize>
      <plugin name="imu_sensor_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <remapping>~/out:=/drone2/imu/data</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="arducopter_plugin" filename="libArduPilotPlugin.so">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <fdm_port_out>9003</fdm_port_out>
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED>0 0 0 3.141593 0 0</gazeboXYZToNED>
      <imuName>drone2::base_link::imu_sensor</imuName>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <control channel="0">
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <jointName>prop_0_joint</jointName>
        <multiplier>838</multiplier>
      </control>
      <control channel="1">
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <jointName>prop_1_joint</jointName>
        <multiplier>838</multiplier>
      </control>
      <control channel="2">
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <jointName>prop_2_joint</jointName>
        <multiplier>-838</multiplier>
      </control>
      <control channel="3">
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <jointName>prop_3_joint</jointName>
        <multiplier>-838</multiplier>
      </control>
    </plugin>
  </gazebo>

</robot>
