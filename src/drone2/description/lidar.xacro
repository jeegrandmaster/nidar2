<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== RPLIDAR A1 (360 2D LiDAR) ==================== -->
  <xacro:property name="lidar_mass" value="0.17"/>
  <xacro:property name="lidar_radius" value="0.035"/>
  <xacro:property name="lidar_height" value="0.04"/>

  <!-- LiDAR Link -->
  <link name="lidar_link">
    <!-- Mounting Mast to central body plate -->
    <visual>
      <origin xyz="0 0 -0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.008" length="0.08"/>
      </geometry>
      <material name="black"/>
    </visual>

    <!-- LiDAR Base (black cylinder) -->
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="0.02"/>
      </geometry>
      <material name="black"/>
    </visual>

    <!-- Scanning Head (red rotating top) -->
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius + 0.003}" length="0.02"/>
      </geometry>
      <material name="red"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius + 0.003}" length="${lidar_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${lidar_mass}"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- Mount on top of the drone (base_link) with full clearance above arms and rotors -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.105" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo tag for the LiDAR sensor -->
  <gazebo reference="lidar_link">
    <material>Gazebo/FlatBlack</material>
    <sensor name="rplidar_a1" type="ray">
      <pose>0 0 0.02 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>10.0</update_rate>
      <visualize>true</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="rplidar_a1_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>
